# ── Database (any PostgreSQL) ────────────────────────────────────────────────
# Either set the parts...
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# ...or override the whole JDBC URL (takes precedence over the DB_* parts):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres

# ── Auth (any OIDC / JWKS provider) ──────────────────────────────────────────
# JWKS endpoint of your identity provider. The token's principal claim must be a UUID.
AUTH_JWKS_URI=https://<your-issuer>/.well-known/jwks.json
# Optional: enforce the issuer claim.
# AUTH_ISSUER=https://<your-issuer>
# Signing algorithm of the provider's tokens.
AUTH_JWS_ALG=ES256
# Claim that holds the user id.
AUTH_PRINCIPAL_CLAIM=sub

# ── LLM (any OpenAI-compatible endpoint) ─────────────────────────────────────
# Defaults target DeepSeek; point these at OpenAI, Ollama, vLLM, Groq, etc.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=<your-llm-api-key>
LLM_TEMPERATURE=0.2

# ── App ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_CALLS_PER_MINUTE=10
# SPRING_PROFILES_ACTIVE=prod

# ── Using Supabase? Map its values onto the generic vars above ────────────────
# DB_HOST=db.<ref>.supabase.co        (or the pooler host on port 6543)
# DB_USER=postgres   DB_PASSWORD=<db password>
# AUTH_JWKS_URI=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
